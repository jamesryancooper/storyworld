      {
        "case": "standalone_editorial_or_fictional_property",
        "release_authority": "storyworld",
        "condition": "project authority policy grants it"
      },
      {
        "case": "commerce_foundry_originated_campaign",
        "release_authority": "commerce_foundry",
        "condition": "always; storyworld creative approval is evidence, not authorization"
      },
      {
        "case": "bekindrewind_runtime_release",
        "release_authority": "bekindrewind_runtime",
        "condition": "runtime acceptance receipt required"
      }
    ]
  },

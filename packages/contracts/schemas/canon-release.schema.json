{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:storyworld-platform,2026:contracts/canon-release/v1",
  "title": "Canon release",
  "description": "Immutable named/versioned snapshot of accepted canon (canonical part 03 section 8; glossary). Facts carry classification, scope, story-time validity, and visibility; models' outputs appear only as accepted content with acceptance receipts (ADR-0008, ADR-0009).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "canon_release_id",
    "property_id",
    "branch",
    "release_name",
    "release_version",
    "created_at",
    "accepted_by_receipt_ref",
    "supersedes_ref",
    "facts",
    "entities",
    "relationships",
    "timeline_events",
    "reference_pack_refs",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "storyworld.canon-release.v1"
    },
    "canon_release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "property_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "branch": {
      "description": "official, alternate, experimental, or adaptation branch name",
      "type": "string",
      "minLength": 1
    },
    "release_name": {
      "type": "string",
      "minLength": 1
    },
    "release_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)?$"
    },
    "accepted_by_receipt_ref": {
      "description": "Approval receipt for the canon_approval layer",
      "type": "string",
      "minLength": 1
    },
    "supersedes_ref": {
      "type": [
        "string",
        "null"
      ],
      "minLength": 1
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "fact_id",
          "revision_id",
          "subject_ref",
          "predicate",
          "value",
          "classification",
          "scope",
          "visibility",
          "status",
          "source_ref"
        ],
        "properties": {
          "fact_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "revision_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "subject_ref": {
            "type": "string",
            "minLength": 1
          },
          "predicate": {
            "type": "string",
            "minLength": 1
          },
          "value": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type",
              "content"
            ],
            "properties": {
              "type": {
                "enum": [
                  "text",
                  "number",
                  "boolean",
                  "date",
                  "entity_ref",
                  "structured"
                ]
              },
              "content": {},
              "unit": {
                "type": "string"
              }
            }
          },
          "classification": {
            "enum": [
              "hard_canon",
              "soft_canon",
              "world_rule",
              "style_rule",
              "production_local_fact",
              "secret_truth",
              "audience_visible_fact",
              "character_belief",
              "deprecated_fact"
            ]
          },
          "scope": {
            "type": "string",
            "minLength": 1
          },
          "story_time_range": {
            "type": "object",
            "additionalProperties": false,
            "required": [],
            "properties": {
              "from": {
                "type": "string"
              },
              "to": {
                "type": "string"
              }
            }
          },
          "visibility": {
            "enum": [
              "public",
              "spoiler",
              "team_private",
              "restricted"
            ]
          },
          "status": {
            "enum": [
              "accepted",
              "deprecated"
            ]
          },
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "rationale": {
            "type": "string"
          },
          "superseded_by_fact_ref": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "entity_type",
          "name",
          "visibility"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "entity_type": {
            "enum": [
              "character",
              "organization",
              "faction",
              "narrator",
              "location",
              "region",
              "set",
              "object",
              "prop",
              "product_reference",
              "artifact",
              "vehicle",
              "collectible",
              "symbol",
              "wardrobe_item",
              "voice_profile"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "visibility": {
            "enum": [
              "public",
              "spoiler",
              "team_private",
              "restricted"
            ]
          },
          "attributes": {
            "type": "object"
          },
          "product_snapshot_ref": {
            "description": "Present only for product_reference entities; pins a Commerce Foundry snapshot (ADR-0010) and is an optional extension, never a mandatory field of generic canon.",
            "type": "string"
          }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "relationship_id",
          "from_entity_ref",
          "to_entity_ref",
          "relationship_type"
        ],
        "properties": {
          "relationship_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "from_entity_ref": {
            "type": "string",
            "minLength": 1
          },
          "to_entity_ref": {
            "type": "string",
            "minLength": 1
          },
          "relationship_type": {
            "type": "string",
            "minLength": 1
          },
          "story_time_range": {
            "type": "object"
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "timeline_events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "event_id",
          "story_time",
          "summary"
        ],
        "properties": {
          "event_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "story_time": {
            "type": "string",
            "minLength": 1
          },
          "summary": {
            "type": "string",
            "minLength": 1
          },
          "entity_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state_transitions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entity_ref",
                "attribute",
                "to_value"
              ],
              "properties": {
                "entity_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "attribute": {
                  "type": "string",
                  "minLength": 1
                },
                "from_value": {},
                "to_value": {}
              }
            }
          }
        }
      }
    },
    "reference_pack_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$",
      "description": "Hash of the canonical serialized form of this release for exact-version binding"
    },
    "assertions": {
      "type": "array",
      "description": "Optional testimony/assertion records, distinct from facts: what a speaker claimed, with honesty, accuracy, confidence, and correction lineage (probes B and G; Stillhouse and Lanterns fixtures). Said, believed, and true remain distinguishable; an assertion never becomes an accepted fact without a separate canon decision.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "speaker_ref",
          "claim",
          "asserted_at_story_time",
          "speaker_knowledge_basis",
          "honesty",
          "accuracy",
          "confidence",
          "visibility",
          "status",
          "superseded_by_ref",
          "evidence_refs"
        ],
        "properties": {
          "assertion_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "speaker_ref": {
            "type": "string",
            "minLength": 1
          },
          "claim": {
            "type": "string",
            "minLength": 1
          },
          "asserted_at_story_time": {
            "type": "string",
            "minLength": 1
          },
          "speaker_knowledge_basis": {
            "type": "string",
            "minLength": 1,
            "description": "What the speaker knew or could know at the moment of testimony."
          },
          "honesty": {
            "enum": [
              "honest",
              "deliberate_lie",
              "unknown"
            ]
          },
          "accuracy": {
            "enum": [
              "accurate",
              "mistaken",
              "partial",
              "undetermined"
            ]
          },
          "confidence": {
            "enum": [
              "certain",
              "probable",
              "disputed",
              "uncertain"
            ]
          },
          "visibility": {
            "enum": [
              "public",
              "spoiler",
              "team_private",
              "restricted"
            ]
          },
          "status": {
            "enum": [
              "active",
              "superseded"
            ]
          },
          "superseded_by_ref": {
            "type": [
              "string",
              "null"
            ]
          },
          "correction_type": {
            "enum": [
              "correction",
              "clarification",
              "retraction"
            ],
            "description": "Present on a successor assertion that corrects, clarifies, or retracts a superseded one; publication history is preserved, never deleted."
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "branch_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch_type",
        "parent_branch",
        "pinned_source_release_ref",
        "overrides",
        "composites",
        "omissions"
      ],
      "properties": {
        "branch_type": {
          "enum": [
            "official",
            "alternate",
            "experimental",
            "adaptation"
          ]
        },
        "parent_branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "pinned_source_release_ref": {
          "type": [
            "string",
            "null"
          ],
          "description": "The exact source canon release this branch adapts; a later source change never silently rewrites the adaptation (probe D)."
        },
        "overrides": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "override_id",
              "target_ref",
              "change_summary"
            ],
            "properties": {
              "override_id": {
                "type": "string",
                "minLength": 1
              },
              "target_ref": {
                "type": "string",
                "minLength": 1
              },
              "change_summary": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "composites": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "composite_entity_ref",
              "replaces_entity_refs"
            ],
            "properties": {
              "composite_entity_ref": {
                "type": "string",
                "minLength": 1
              },
              "replaces_entity_refs": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        },
        "omissions": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "description": "Optional branch ancestry for alternate, experimental, and adaptation branches: explicit overrides, composites, and omissions; adaptations never mutate their source branch (probe D; ADR-0009)."
    },
    "shared_canon_dependencies": {
      "type": "array",
      "description": "Optional version-pinned dependencies on another property's canon release, mirroring the accepted product-snapshot pattern (probe E). Shared entities are referenced by pinned version, never copied silently and never mutated by consumers; deliberate forks record lineage.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "provider_property_ref",
          "pinned_canon_release_ref",
          "entity_refs"
        ],
        "properties": {
          "provider_property_ref": {
            "type": "string",
            "minLength": 1
          },
          "pinned_canon_release_ref": {
            "type": "string",
            "minLength": 1
          },
          "entity_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "fork_lineage": {
            "type": [
              "object",
              "null"
            ],
            "additionalProperties": false,
            "required": [
              "forked_entity_ref",
              "forked_from_ref",
              "forked_on"
            ],
            "properties": {
              "forked_entity_ref": {
                "type": "string",
                "minLength": 1
              },
              "forked_from_ref": {
                "type": "string",
                "minLength": 1
              },
              "forked_on": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)?$"
              }
            }
          }
        }
      }
    }
  }
}

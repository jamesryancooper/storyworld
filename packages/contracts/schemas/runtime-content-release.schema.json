{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:storyworld-platform,2026:contracts/runtime-content-release/v1",
  "title": "Runtime content release",
  "description": "Immutable content package compiled for a target runtime (canonical part 04 section 12.3; ADR-0012). Contains authored source content only.",
  "$comment": "ADR-0012 boundary: this package must never contain player state, saves, sessions, progression, or any execution-time state. The runtime owns those exclusively; a schema change adding such fields is a boundary violation, not an extension.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "property_id",
    "canon_release_ref",
    "target",
    "compiler",
    "locations",
    "spatial_relationships",
    "entities",
    "dialogue",
    "missions",
    "items",
    "triggers",
    "sound_zones",
    "asset_index",
    "governance_metadata",
    "release_notes",
    "created_at",
    "content_sha256"
  ],
  "properties": {
    "schema_version": {
      "const": "storyworld.runtime-content-release.v1"
    },
    "release_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "property_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "canon_release_ref": {
      "type": "string",
      "minLength": 1
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runtime",
        "target_version",
        "capability_requirements"
      ],
      "properties": {
        "runtime": {
          "type": "string",
          "minLength": 1
        },
        "target_version": {
          "type": "string",
          "minLength": 1
        },
        "capability_requirements": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "compiler": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
        }
      }
    },
    "locations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "location_id",
          "name",
          "era_rules"
        ],
        "properties": {
          "location_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "era_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "attributes": {
            "type": "object"
          }
        }
      }
    },
    "spatial_relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_location_ref",
          "to_location_ref",
          "relation"
        ],
        "properties": {
          "from_location_ref": {
            "type": "string",
            "minLength": 1
          },
          "to_location_ref": {
            "type": "string",
            "minLength": 1
          },
          "relation": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "entity_id",
          "name",
          "runtime_metadata"
        ],
        "properties": {
          "entity_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "appearance_asset_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "runtime_metadata": {
            "type": "object",
            "description": "Runtime-facing authored metadata only; never live state."
          }
        }
      }
    },
    "dialogue": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "dialogue_id",
          "nodes"
        ],
        "properties": {
          "dialogue_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "entity_ref": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node_id",
                "speaker_ref",
                "line",
                "conditions",
                "next_node_refs"
              ],
              "properties": {
                "node_id": {
                  "type": "string",
                  "minLength": 1
                },
                "speaker_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "line": {
                  "type": "string",
                  "minLength": 1
                },
                "localization_ref": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "minLength": 1
                },
                "conditions": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "next_node_refs": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            }
          }
        }
      }
    },
    "localization_string_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "missions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "mission_id",
          "name",
          "prerequisites",
          "authored_outcomes",
          "state_effects"
        ],
        "properties": {
          "mission_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "prerequisites": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "description": "Mission refs that must complete first; the graph must be acyclic."
          },
          "authored_outcomes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "state_effects": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "entity_ref",
                "attribute",
                "to_value"
              ],
              "properties": {
                "entity_ref": {
                  "type": "string",
                  "minLength": 1
                },
                "attribute": {
                  "type": "string",
                  "minLength": 1
                },
                "to_value": {}
              }
            }
          }
        }
      }
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "item_id",
          "name"
        ],
        "properties": {
          "item_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "item_type": {
            "type": [
              "string",
              "null"
            ],
            "minLength": 1
          },
          "collectible": {
            "type": "boolean"
          },
          "state_rules": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "triggers": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "trigger_id",
          "condition",
          "effect_refs"
        ],
        "properties": {
          "trigger_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "condition": {
            "type": "string",
            "minLength": 1
          },
          "effect_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "sound_zones": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "zone_id",
          "location_ref",
          "intent",
          "source_asset_refs"
        ],
        "properties": {
          "zone_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
          },
          "location_ref": {
            "type": "string",
            "minLength": 1
          },
          "intent": {
            "type": "string",
            "minLength": 1
          },
          "source_asset_refs": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "asset_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_version_ref",
          "location",
          "content_type",
          "size_bytes",
          "sha256",
          "embedding"
        ],
        "properties": {
          "asset_version_ref": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "description": "Embedded relative path for portable packages, or an immutable object URI with scoped access for connected packages (ADR-0014).",
            "type": "string",
            "minLength": 1
          },
          "content_type": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "embedding": {
            "enum": [
              "embedded",
              "referenced"
            ]
          }
        }
      }
    },
    "governance_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_evidence_refs",
        "provenance_complete",
        "disclosure_obligations",
        "sensitivity"
      ],
      "properties": {
        "rights_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance_complete": {
          "type": "boolean"
        },
        "disclosure_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "embargoed"
          ]
        }
      }
    },
    "release_notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "created_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)?$"
    },
    "content_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}

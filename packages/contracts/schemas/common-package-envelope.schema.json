{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:storyworld-platform,2026:contracts/common-package-envelope/v1",
  "title": "Common package envelope",
  "description": "Shared envelope for all connected and portable Storyworld package types (canonical part 04 section 14.4; ADR-0010, ADR-0014). Packages exclude secrets, connector credentials, unnecessary personal information, restricted private notes, and hidden provider reasoning.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "package_type",
    "package_version",
    "origin",
    "authority_host",
    "identifiers",
    "snapshots",
    "manifest",
    "asset_index",
    "governance_metadata",
    "approval_receipts",
    "validation_reports",
    "integration_associations",
    "signature"
  ],
  "properties": {
    "schema_version": {
      "const": "storyworld.package-envelope.v1"
    },
    "package_type": {
      "enum": [
        "portable_project",
        "creative_release",
        "channel_package",
        "narrative_asset_bundle",
        "runtime_content_release",
        "canon_release_export"
      ]
    },
    "package_version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "system",
        "system_version",
        "created_at"
      ],
      "properties": {
        "system": {
          "type": "string",
          "minLength": 1
        },
        "system_version": {
          "type": "string",
          "minLength": 1
        },
        "created_at": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)?$"
        }
      }
    },
    "authority_host": {
      "enum": [
        "storyworld",
        "commerce_foundry",
        "bekindrewind_runtime"
      ]
    },
    "identifiers": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workspace_id",
        "property_id",
        "correlation_id"
      ],
      "properties": {
        "workspace_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "property_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "production_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "release_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "correlation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "causation_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      }
    },
    "snapshots": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "canon_release_ref"
      ],
      "properties": {
        "canon_release_ref": {
          "type": "string",
          "minLength": 1
        },
        "source_snapshot_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "manifest": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_refs",
        "narrative_unit_refs",
        "asset_version_refs"
      ],
      "properties": {
        "entity_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "narrative_unit_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "asset_version_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "asset_index": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_version_ref",
          "location",
          "content_type",
          "size_bytes",
          "sha256",
          "embedding"
        ],
        "properties": {
          "asset_version_ref": {
            "type": "string",
            "minLength": 1
          },
          "location": {
            "description": "Embedded relative path for portable packages, or an immutable object URI with scoped access for connected packages (ADR-0014).",
            "type": "string",
            "minLength": 1
          },
          "content_type": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "embedding": {
            "enum": [
              "embedded",
              "referenced"
            ]
          }
        }
      }
    },
    "governance_metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rights_evidence_refs",
        "provenance_complete",
        "disclosure_obligations",
        "sensitivity"
      ],
      "properties": {
        "rights_evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "provenance_complete": {
          "type": "boolean"
        },
        "disclosure_obligations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensitivity": {
          "enum": [
            "public",
            "internal",
            "confidential",
            "restricted",
            "embargoed"
          ]
        }
      }
    },
    "approval_receipts": {
      "type": "array",
      "items": {
        "$ref": "tag:storyworld-platform,2026:contracts/approval-receipt/v1"
      }
    },
    "validation_reports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "report_type",
          "result",
          "produced_at",
          "report_ref"
        ],
        "properties": {
          "report_type": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "enum": [
              "pass",
              "findings",
              "fail"
            ]
          },
          "produced_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)?$"
          },
          "report_ref": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "integration_associations": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "commerce_campaign_ref": {
          "type": "string",
          "minLength": 1
        },
        "product_snapshot_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "runtime_target": {
          "type": "string",
          "minLength": 1
        },
        "channel_account_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": []
    },
    "expiry": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}(T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z)?$"
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "key_id",
        "detached_signature_sha256"
      ],
      "properties": {
        "algorithm": {
          "type": "string",
          "minLength": 1
        },
        "key_id": {
          "type": "string",
          "minLength": 1
        },
        "detached_signature_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "SHA-256 of the detached signature file shipped alongside the package; the signature itself is never embedded."
        }
      }
    }
  }
}

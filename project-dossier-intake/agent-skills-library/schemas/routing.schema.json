{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tag:storyworld-platform,2026:agent-skill-library/routing/v1",
  "title": "Storyworld Skill Routing Registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "library_version",
    "default_router",
    "external_existing_skills",
    "routes"
  ],
  "properties": {
    "schema_version": {
      "const": "storyworld.skill-library.routing.v1"
    },
    "library_version": {
      "type": "string"
    },
    "default_router": {
      "type": "string"
    },
    "external_existing_skills": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "match",
          "primary",
          "companions",
          "gates"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "match": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "primary": {
            "type": "string"
          },
          "companions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "gates": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
